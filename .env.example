# Copia este archivo a `.env` y pon tu clave dentro.
# El `.env` real nunca se sube al repositorio ni se abre en pantalla.

OPENAI_API_KEY=

# El trazado a LangSmith va apagado a proposito: por defecto, tus ejecuciones
# se envian a un servicio externo. Se ve en la diapositiva 16.
LANGSMITH_TRACING=false
